# ===== 复制为 .env 后填写；.env 严禁进仓库（docs/11） =====

# --- cpk-agnes 生图 / 多模态 (docs/06) ---
AGNES_BASE_URL=
AGNES_API_KEY=
AGNES_CHAT_MODEL=
AGNES_IMAGE_MODEL=

# ---- LLM 网关 ----
# 未配置时全局回退 mock（确定性，可离线开发/测试）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_CONCURRENCY=3

# ---- 服务端 ----
PORT=8787
SQLITE_PATH=./data/game.db
SSE_HEARTBEAT_MS=30000

# ---- 检索（缺失自动跳过，不中断管线） ----
SEARCH_API_KEY=

# ---- 日志 ----
LOG_LEVEL=info

# ---- 知乎 CLI（可选）----
# 知乎开放平台 Access Secret 由 CLI 自行保管（keychain），本项目不存储凭证。
# 仅用于指定 zhihu-cli 可执行文件路径；未配置时自动在标准路径检测。
# 默认路径：Windows: %LOCALAPPDATA%\ZhihuCLI\current\zhihu-cli.exe
#           macOS/Linux: ~/.local/share/zhihu-cli/current/zhihu-cli
ZHIHU_CLI_BIN=