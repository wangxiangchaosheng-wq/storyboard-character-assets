# ===== 复制为 .env 后填写；.env 严禁进仓库（docs/11） =====

# --- cpk-agnes 生图 / 多模态 (docs/06) ---
AGNES_BASE_URL=
AGNES_API_KEY=
AGNES_CHAT_MODEL=
AGNES_IMAGE_MODEL=

# ---- LLM 网关 ----
# 未配置时全局回退 mock（确定性，可离线开发/测试）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
LLM_CONCURRENCY=3

# ---- 服务端 ----
PORT=8787
SQLITE_PATH=./data/game.db
SSE_HEARTBEAT_MS=30000

# ---- 检索（缺失自动跳过，不中断管线） ----
SEARCH_API_KEY=

# ---- 日志 ----
LOG_LEVEL=info