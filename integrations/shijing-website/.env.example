# 本地启动模板，不含个人密钥。在线功能请在本机 .env 中配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_IMAGE_MODEL=image2
OPENAI_WEB_SEARCH=true
NEXT_PUBLIC_SITE_URL=http://localhost:3002
AGENT_SERVICE_URL=http://127.0.0.1:4318
AGENT_SERVICE_TOKEN=
AGENT_PORT=4318
WEB_PORT=3002
AGENT_DATA_DIR=.agent-data
SIM_ENGINE_URL=
OPENAI_COMPATIBLE_CONFIRMED=false
OPENAI_USE_SYSTEM_PROXY=false
# 先验证离线素材与本地推演；配置密钥后再启用在线生成。
AGENT_ALLOW_API_GENERATION=false
CHARACTER_LIBRARY_DIR=人物素材库
